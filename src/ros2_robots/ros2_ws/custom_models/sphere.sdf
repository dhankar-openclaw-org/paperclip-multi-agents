<?xml version="1.0" ?>
<sdf version="1.6">

  <model name="sphere">

    <static>false</static>

    <link name="sphere_link">

      <inertial>
        <mass>1.0</mass>
      </inertial>

      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.25</radius>
          </sphere>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.25</radius>
          </sphere>
        </geometry>
      </visual>

    </link>

  </model>

</sdf>