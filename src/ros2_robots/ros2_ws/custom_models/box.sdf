<?xml version="1.0" ?>
<sdf version="1.6">

  <model name="sphere">

    <static>false</static>

    <link name="sphere_link">

      <inertial>
        <mass>1.0</mass>
      </inertial>

      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.25</radius>
          </sphere>
        </geometry>
      </collision>

<material>

  <ambient>
    1 0.5 0 1
  </ambient>

  <diffuse>
    1 0.5 0 1
  </diffuse>

  <specular>
    1 1 1 1
  </specular>

</material>

    </link>

  </model>

</sdf>